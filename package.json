    "source": "build",
    "inlineCss": false,
    "concurrency": 1,
    "crawl": false,
    "skipThirdPartyRequests": true,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "include": [
      "/en",
      "/es",
      "/nl",
      "/fr",
      "/cn",
      "/ko",
      "/coco-peat-supplier",
      "/coco-peat-supplier/south-korea",
      "/coco-peat-supplier/netherlands",
      "/coco-peat-supplier/united-states",
      "/coco-peat-supplier/australia",
      "/coco-peat-supplier/new-zealand",
      "/coco-peat-supplier/spain",
      "/blog",
      "/blog/low-ec-vs-high-ec-coco-peat-procurement-guide",
      "/blog/import-coco-coir-from-india-phytosanitary-compliance-guide",
      "/blog/how-to-use-coco-peat-blocks-hydration-guide",
      "/blog/coco-peat-vs-peat-moss-commercial-growing-comparison",
      "/blog/coco-peat-for-strawberries-and-tomatoes-substrate-guide",
      "/blog/5kg-coco-peat-blocks-40ft-container-loading-guide",
      "/ko/blog",
      "/ko/blog/low-ec-vs-high-ec-coco-peat-procurement-guide",
      "/ko/blog/import-coco-coir-from-india-phytosanitary-compliance-guide",
      "/ko/blog/how-to-use-coco-peat-blocks-hydration-guide",
      "/ko/blog/coco-peat-vs-peat-moss-commercial-growing-comparison",
      "/ko/blog/coco-peat-for-strawberries-and-tomatoes-substrate-guide",
      "/ko/blog/5kg-coco-peat-blocks-40ft-container-loading-guide",
      "/cn/blog",
      "/cn/blog/low-ec-vs-high-ec-coco-peat-procurement-guide",
      "/cn/blog/import-coco-coir-from-india-phytosanitary-compliance-guide",
      "/cn/blog/how-to-use-coco-peat-blocks-hydration-guide",
      "/cn/blog/coco-peat-vs-peat-moss-commercial-growing-comparison",
      "/cn/blog/coco-peat-for-strawberries-and-tomatoes-substrate-guide",
      "/cn/blog/5kg-coco-peat-blocks-40ft-container-loading-guide"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "safari >= 12",
      "ios_saf >= 12",
      "chrome >= 73"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "react-snap": "^1.23.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.1"
  }
}
